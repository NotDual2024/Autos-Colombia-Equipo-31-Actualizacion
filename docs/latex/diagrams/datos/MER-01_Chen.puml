@startchen MER-01_Chen
' MER-01 - Modelo Entidad-Relación (notación de Chen) - sistema completo - v1.3
title MER - Parqueadero "Autos Colombia" (sistema completo, DEC-001)

entity USUARIO {
  id <<key>>
  username
  nombre
  rol
  activo
}
entity HORARIO_OPERADOR <<weak>> {
  dia_semana
  hora_inicio
  hora_fin
}
entity PROPIETARIO {
  id <<key>>
  numero_documento
  nombre_completo
  telefono
  correo
  direccion
}
entity VEHICULO {
  id <<key>>
  placa
  tipo
  marca
  nombre
  modelo
  color
}
entity CELDA {
  id <<key>>
  codigo
  tipo
}
entity TARIFA {
  id <<key>>
  categoria
  valor
  vigente_desde
}
entity PAGO {
  id <<key>>
  periodo_inicio
  periodo_fin
  valor
  fecha_pago
}
entity ESTADIA {
  id <<key>>
  fecha_hora_entrada
  fecha_hora_salida
}
entity NOVEDAD {
  id <<key>>
  tipo
  descripcion
  fecha_hora_ocurrencia
}
entity AVISO_CORREO {
  id <<key>>
  numero_envio
  origen
  resultado
  fecha_hora
}
entity AUTORIZACION_FUERA_TURNO {
  id <<key>>
  desde
  hasta
  motivo
}
entity SOLICITUD_CAMBIO {
  id <<key>>
  estado
  motivo
  fecha_solicitud
}
entity HISTORIAL_PROPIEDAD {
  id <<key>>
  desde
  hasta
}
entity REGISTRO_OPERACION {
  id <<key>>
  fecha_hora
  accion
  entidad
  entidad_id
  detalle
}
entity CONTACTO_AUTORIDAD {
  id <<key>>
  fecha_hora
  observacion
}

relationship TIENE_HORARIO <<identifying>> {
}
relationship POSEE {
}
relationship PAGA {
}
relationship INGRESA {
}
relationship OCUPA {
}
relationship INVOLUCRA {
}
relationship AVISA {
}
relationship ESCALA {
}
relationship REGISTRA {
}
relationship AUTORIZA {
}
relationship SOLICITA {
}
relationship TUVO {
}
relationship REALIZA {
}

USUARIO -1- TIENE_HORARIO
TIENE_HORARIO =N= HORARIO_OPERADOR
PROPIETARIO -1- POSEE
POSEE =N= VEHICULO
VEHICULO -1- PAGA
PAGA -N- PAGO
VEHICULO -1- INGRESA
INGRESA -N- ESTADIA
CELDA -1- OCUPA
OCUPA -N- ESTADIA
NOVEDAD =N= INVOLUCRA
INVOLUCRA -M- ESTADIA
PAGO -1- AVISA
AVISA -N- AVISO_CORREO
PAGO -1- ESCALA
ESCALA -N- CONTACTO_AUTORIDAD
USUARIO -1- REGISTRA
REGISTRA -N- ESTADIA
USUARIO -1- AUTORIZA
AUTORIZA -N- AUTORIZACION_FUERA_TURNO
VEHICULO -1- SOLICITA
SOLICITA -N- SOLICITUD_CAMBIO
VEHICULO -1- TUVO
TUVO -N- HISTORIAL_PROPIEDAD
USUARIO -1- REALIZA
REALIZA -N- REGISTRO_OPERACION
@endchen
