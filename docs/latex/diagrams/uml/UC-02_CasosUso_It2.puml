@startuml UC-02_CasosUso_It2
' UC-02 - Diagrama de casos de uso - Iteración 2 - v2 (CHG-003: gestión de celdas)
left to right direction
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F4F7FC
  BorderColor #0B3D91
}
title Casos de uso - Iteración 2: Gestión de usuarios y gestión de celdas

actor "Operador" as Op
actor "Administrador" as Ad
actor "Reloj del sistema" as Re <<sistema>>
Ad -up-|> Op

rectangle "Sistema de gestión del parqueadero" {
  usecase "UC-01 Iniciar sesión" as UC01
  usecase "UC-16 Registrar propietario" as UC16
  usecase "UC-17 Registrar vehículo" as UC17
  usecase "UC-18 Consultar propietarios\ny vehículos (fichas)" as UC18
  usecase "UC-19 Modificar, activar\ne inactivar" as UC19
  usecase "UC-20 Solicitar cambio\nde propietario" as UC20
  usecase "UC-21 Resolver solicitud\nde cambio" as UC21
  usecase "UC-22 Consultar mapa\nde celdas" as UC22
  usecase "UC-23 Editar operador y\nrestablecer contraseña" as UC23
  usecase "UC-24 Asignar horarios" as UC24
  usecase "UC-25 Verificar turno" as UC25
  usecase "UC-26 Cerrar sesión por\nfin de turno" as UC26
  usecase "UC-27 Autorizar ingreso\nfuera de turno" as UC27
  usecase "UC-28 Consultar bitácora" as UC28
  usecase "UC-29 Registrar operación\nen la bitácora" as UC29
  usecase "UC-41 Crear celda" as UC41
  usecase "UC-42 Consultar celdas y\ncambiar el tipo" as UC42
  usecase "UC-43 Inactivar y\nreactivar celda" as UC43
  usecase "UC-44 Eliminar celda\nsin historial" as UC44
}

Op --> UC01
Op --> UC16
Op --> UC17
Op --> UC18
Op --> UC19
Op --> UC20
Op --> UC22
Ad --> UC21
Ad --> UC23
Ad --> UC24
Ad --> UC27
Ad --> UC28
Ad --> UC41
Ad --> UC42
Ad --> UC43
Ad --> UC44
Re --> UC26

UC01 ..> UC25 : <<include>>
UC20 .> UC18 : <<extend>>\n(desde la ficha del vehículo)
UC19 .> UC18 : <<extend>>\n(desde la ficha)
UC16 ..> UC29 : <<include>>
UC17 ..> UC29 : <<include>>
UC19 ..> UC29 : <<include>>
UC20 ..> UC29 : <<include>>
UC21 ..> UC29 : <<include>>
UC23 ..> UC29 : <<include>>
UC24 ..> UC29 : <<include>>
UC27 ..> UC29 : <<include>>
UC41 ..> UC29 : <<include>>
UC42 ..> UC29 : <<include>>
UC43 ..> UC29 : <<include>>
UC44 ..> UC29 : <<include>>
UC43 .> UC42 : <<extend>>\n(desde la lista)
UC44 .> UC42 : <<extend>>\n(desde la lista)
@enduml
